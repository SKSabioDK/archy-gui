{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Archy GUI",
      "type": "shell",
      "command": "node server.js",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^([^\\s].*)\\((\\d+,\\d+)\\):\\s+(error|warning|info)\\s+(.*)$",
          "file": 1,
          "location": 2,
          "severity": 3,
          "message": 4
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Archy GUI running on"
        }
      }
    },
    {
      "label": "Install Dependencies",
      "type": "shell",
      "command": "npm install",
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Åbn i browser",
      "type": "shell",
      "command": "start http://localhost:3737",
      "windows": {
        "command": "start http://localhost:3737"
      },
      "group": "build",
      "presentation": {
        "reveal": "never"
      }
    }
  ]
}
